@model TenxOCC.Data.Entities.InvoiceHeader
@{
    string mode = ViewBag.FormMode as string ?? "create"; // "create", "edit", or "view"
    bool isView = mode == "view";
    bool isEdit = mode == "edit";
    bool isCreate = mode == "create";
}

<style>
    .sneat-single-card {
        border-radius: 0.5rem;
    }
    .sneat-form-label {
        font-size: 0.825rem;
        font-weight: 600;
        color: #566a7f;
        margin-bottom: 0;
    }
    .sneat-single-table th {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background-color: #f5f5f9;
        color: #566a7f;
    }
    .sneat-single-table td {
        padding: 0.4rem 0.5rem;
    }
    .sneat-single-table input.form-control-sm,
    .sneat-single-table select.form-select-sm {
        font-size: 0.85rem;
        padding: 0.25rem 0.4rem;
    }
</style>

<!-- SINGLE CARD CONTAINER FOR THE ENTIRE INVOICE FORM -->
<div class="card shadow-sm sneat-single-card">
    <div class="card-body p-4">
        <form id="arInvoiceForm" onsubmit="return false;">
            <input type="hidden" id="ar_DocEntry" value="@(Model != null ? Model.DocEntry : 0)" />
            <input type="hidden" id="ar_CustomerStreet" value="@(Model != null ? Model.CustomerStreet : "")" />
            <input type="hidden" id="ar_CustomerCity" value="@(Model != null ? Model.CustomerCity : "")" />
            <input type="hidden" id="ar_CustomerZip" value="@(Model != null ? Model.CustomerZip : "")" />
            <input type="hidden" id="ar_CustomerCountry" value="@(Model != null ? Model.CustomerCountry : "")" />
            <input type="hidden" id="ar_BillingAddressCode" value="@(Model != null ? Model.BillingAddressCode : "")" />
            <input type="hidden" id="ar_SupplierName" value="@(Model != null ? Model.SupplierName : "")" />
            <input type="hidden" id="ar_SupplierVAT" value="@(Model != null ? Model.SupplierVAT : "")" />
            <input type="hidden" id="ar_BankCode" value="@(Model != null ? Model.BankCode : "")" />
            <input type="hidden" id="ar_IBAN" value="@(Model != null ? Model.IBAN : "")" />

            <!-- =================================================================== -->
            <!-- TOP SECTION: HEADER FIELDS (LEFT & RIGHT SIDE-BY-SIDE)              -->
            <!-- =================================================================== -->
            <div class="row g-4 mb-4">
                <!-- Left Column Header Fields -->
                <div class="col-md-6">
                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Customer</label>
                        <div class="col-sm-8">
                            <div class="input-group input-group-sm">
                                <input type="text" id="ar_CardCode" class="form-control" value="@(Model != null ? Model.CardCode : "")" placeholder="Customer Code" @(isView ? "readonly" : "") />
                                @if (!isView)
                                {
                                    <button class="btn btn-outline-secondary" type="button" title="Lookup Customer"><i class="bx bx-search"></i></button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Name</label>
                        <div class="col-sm-8">
                            <input type="text" id="ar_CardName" class="form-control form-control-sm" value="@(Model != null ? (Model.CardName ?? Model.CustomerVAT ?? Model.SupplierName) : "")" placeholder="Customer Name" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Contact Person</label>
                        <div class="col-sm-8">
                            <input type="text" id="ar_ContactPerson" class="form-control form-control-sm" value="@(Model != null && !string.IsNullOrEmpty(Model.CustomerContactName) ? Model.CustomerContactName : "Balaji Deshmukh")" placeholder="Contact Person" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Customer Ref. No.</label>
                        <div class="col-sm-8">
                            <input type="text" id="ar_BuyerReference" class="form-control form-control-sm" value="@(Model != null ? Model.BuyerReference : "")" placeholder="Customer Ref. No." @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">BP Currency</label>
                        <div class="col-sm-8">
                            <div class="row g-2">
                                <div class="col-5">
                                    <select id="ar_DocCur" class="form-select form-select-sm" @(isView ? "disabled" : "")>
                                        <option value="DKK" @(Model != null && Model.DocCur == "DKK" ? "selected" : "")>DKK</option>
                                        <option value="USD" @(Model != null && Model.DocCur == "USD" ? "selected" : "")>USD</option>
                                        <option value="EUR" @(Model != null && Model.DocCur == "EUR" ? "selected" : "")>EUR</option>
                                        <option value="GBP" @(Model != null && Model.DocCur == "GBP" ? "selected" : "")>GBP</option>
                                        <option value="THB" @(Model != null && Model.DocCur == "THB" ? "selected" : "")>THB</option>
                                    </select>
                                </div>
                                <div class="col-7">
                                    <input type="number" step="0.0001" id="ar_ExchangeRate" class="form-control form-control-sm text-end" value="@(Model != null && Model.ExchangeRate.HasValue ? Model.ExchangeRate.Value.ToString("0.0000") : "1.0000")" placeholder="Exchange Rate" @(isView ? "readonly" : "") />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column Header Fields -->
                <div class="col-md-6">
                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">No.</label>
                        <div class="col-sm-8">
                            <input type="number" id="ar_DocNum" class="form-control form-control-sm fw-bold" value="@(Model != null ? Model.DocNum : 0)" placeholder="DocNum (Auto)" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Status</label>
                        <div class="col-sm-8">
                            <span class="badge bg-label-success fs-6">Open</span>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Posting Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="ar_DocDate" class="form-control form-control-sm" value="@(Model != null ? Model.DocDate.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Due Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="ar_DocDueDate" class="form-control form-control-sm" value="@(Model != null && Model.DocDueDate.HasValue ? Model.DocDueDate.Value.ToString("yyyy-MM-dd") : DateTime.Now.AddDays(30).ToString("yyyy-MM-dd"))" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Document Date</label>
                        <div class="col-sm-8">
                            <input type="date" id="ar_DocumentDate" class="form-control form-control-sm" value="@(Model != null ? Model.DocDate.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Payment Terms</label>
                        <div class="col-sm-8">
                            <input type="text" id="ar_PaymentTerms" class="form-control form-control-sm" value="@(Model != null ? Model.PaymentTerms : "Net 30")" placeholder="Payment Terms" @(isView ? "readonly" : "") />
                        </div>
                    </div>
                </div>
            </div>

            <!-- =================================================================== -->
            <!-- MIDDLE SECTION: TABLE SECTION                                       -->
            <!-- =================================================================== -->
            <div class="d-flex justify-content-end align-items-center mb-2">
                @if (!isView)
                {
                    <button type="button" class="btn btn-sm btn-primary" onclick="addArLineRow()">
                        <i class="bx bx-plus me-1"></i> Add Row
                    </button>
                }
            </div>

            <div class="table-responsive border rounded mb-4">
                <table class="table table-hover align-middle mb-0 sneat-single-table" id="arGridTable">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="text-center">#</th>
                            <th style="width: 140px;">Item Code</th>
                            <th>Description</th>
                            <th style="width: 90px;" class="text-end">Qty</th>
                            <th style="width: 110px;" class="text-end">Unit Price</th>
                            <th style="width: 90px;" class="text-end">Disc %</th>
                            <th style="width: 110px;" class="text-end">Price After Disc</th>
                            <th style="width: 100px;">Tax Code</th>
                            <th style="width: 100px;" class="text-end">Tax Amt</th>
                            <th style="width: 120px;" class="text-end">Line Total</th>
                            <th style="width: 90px;">UoM</th>
                            @if (!isView)
                            {
                                <th style="width: 50px;" class="text-center">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody id="arGridBody">
                        @if (Model != null && Model.InvoiceLines != null && Model.InvoiceLines.Any())
                        {
                            int idx = 1;
                            foreach (var l in Model.InvoiceLines)
                            {
                                <tr>
                                    <td class="ar-line-no text-center fw-bold text-muted">@idx</td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm ar-item-code" value="@l.ItemCode" placeholder="Item Code" @(isView ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm ar-item-desc" value="@l.Description" placeholder="Item Description" @(isView ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-qty text-end" value="@l.Quantity.ToString("0.00")" onchange="recalcArRow(this)" @(isView ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-unit-price text-end" value="@l.UnitPrice.ToString("0.00")" onchange="recalcArRow(this)" @(isView ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-disc-pct text-end" value="@l.DiscountPercent.ToString("0.00")" onchange="recalcArRow(this)" @(isView ? "readonly" : "") />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-price-after text-end bg-light" value="@((l.UnitPrice * (1 - l.DiscountPercent/100m)).ToString("0.00"))" readonly />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm ar-tax-code" onchange="recalcArRow(this)" @(isView ? "disabled" : "")>
                                            <option value="O1" @(l.VatGroup == "O1" || l.VatPercent == 5 ? "selected" : "")>O1 (5%)</option>
                                            <option value="S1" @(l.VatGroup == "S1" || l.VatPercent == 7 ? "selected" : "")>S1 (7%)</option>
                                            <option value="EX" @(l.VatGroup == "EX" || l.VatPercent == 0 ? "selected" : "")>EX (0%)</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-tax-amt text-end bg-light text-warning fw-semibold" value="@l.VatAmount.ToString("0.00")" readonly />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" class="form-control form-control-sm ar-line-total text-end bg-light fw-bold text-success" value="@l.LineTotal.ToString("0.00")" readonly />
                                    </td>
                                    <td>
                                        <select class="form-select form-select-sm ar-uom" @(isView ? "disabled" : "")>
                                            <option value="Manual" @(l.UnitOfMeasure == "Manual" ? "selected" : "")>Manual</option>
                                            <option value="6Pack" @(l.UnitOfMeasure == "6Pack" ? "selected" : "")>6Pack</option>
                                            <option value="Pack" @(l.UnitOfMeasure == "Pack" ? "selected" : "")>Pack</option>
                                            <option value="Pcs" @(l.UnitOfMeasure == "Pcs" ? "selected" : "")>Pcs</option>
                                        </select>
                                    </td>
                                    @if (!isView)
                                    {
                                        <td class="text-center">
                                            <button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="removeArLineRow(this)" title="Delete Row">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </td>
                                    }
                                </tr>
                                idx++;
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- =================================================================== -->
            <!-- BOTTOM SECTION: FOOTER FIELDS (LEFT & RIGHT SIDE-BY-SIDE)           -->
            <!-- =================================================================== -->
            <div class="row g-4 mb-3">
                <!-- Left Side Footer Fields -->
                <div class="col-md-6">
                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Sales Employee</label>
                        <div class="col-sm-8">
                            <select id="ar_SalesEmployee" class="form-select form-select-sm" @(isView ? "disabled" : "")>
                                <option>- No Sales Employee / Buyer -</option>
                                <option>John Smith</option>
                                <option>Alice Brown</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label">Owner</label>
                        <div class="col-sm-8">
                            <input type="text" id="ar_Owner" class="form-control form-control-sm" value="Manager" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-4 col-form-label sneat-form-label"></label>
                        <div class="col-sm-8">
                            <div class="form-check">
                                <input type="checkbox" id="ar_PaymentOrderRun" class="form-check-input mt-0 me-1" @(isView ? "disabled" : "") />
                                <label for="ar_PaymentOrderRun" class="form-check-label sneat-form-label">Payment Order Run</label>
                            </div>
                        </div>
                    </div>

                    <div class="row align-items-start">
                        <label class="col-sm-4 col-form-label sneat-form-label">Remarks</label>
                        <div class="col-sm-8">
                            <textarea id="ar_Remarks" class="form-control form-control-sm" rows="3" placeholder="Remarks" @(isView ? "readonly" : "")>Based On Deliveries 1472.</textarea>
                        </div>
                    </div>
                </div>

                <!-- Right Side Footer Fields -->
                <div class="col-md-6">
                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Total Before Discount</label>
                        <div class="col-sm-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text ar-cur-symbol">@(Model != null && !string.IsNullOrEmpty(Model.DocCur) ? Model.DocCur : "DKK")</span>
                                <input type="number" step="0.01" id="ar_TotalBeforeDiscount" class="form-control text-end fw-semibold" value="@(Model != null ? (Model.DocTotal - Model.VatSum + Model.DiscountTotal).ToString("0.00") : "0.00")" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Discount</label>
                        <div class="col-sm-7">
                            <div class="row g-2">
                                <div class="col-5">
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="0.01" id="ar_DiscountPercent" class="form-control text-end" value="0.00" onchange="recalcArTotals()" @(isView ? "readonly" : "") />
                                        <span class="input-group-text">%</span>
                                    </div>
                                </div>
                                <div class="col-7">
                                    <input type="number" step="0.01" id="ar_DiscountTotal" class="form-control form-control-sm text-end" value="@(Model != null ? Model.DiscountTotal.ToString("0.00") : "0.00")" onchange="recalcArTotals()" @(isView ? "readonly" : "") />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Freight</label>
                        <div class="col-sm-7">
                            <input type="number" step="0.01" id="ar_Freight" class="form-control form-control-sm text-end" value="0.00" onchange="recalcArTotals()" @(isView ? "readonly" : "") />
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Rounding</label>
                        <div class="col-sm-7">
                            <div class="input-group input-group-sm">
                                <div class="input-group-text">
                                    <input type="checkbox" id="ar_RoundingCheck" class="form-check-input mt-0" onchange="recalcArTotals()" @(isView ? "disabled" : "") />
                                </div>
                                <input type="number" step="0.01" id="ar_RoundDifference" class="form-control text-end" value="@(Model != null ? Model.RoundDifference.ToString("0.00") : "0.00")" onchange="recalcArTotals()" @(isView ? "readonly" : "") />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Tax</label>
                        <div class="col-sm-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text ar-cur-symbol">@(Model != null && !string.IsNullOrEmpty(Model.DocCur) ? Model.DocCur : "DKK")</span>
                                <input type="number" step="0.01" id="ar_VatSum" class="form-control text-end fw-semibold text-warning" value="@(Model != null ? Model.VatSum.ToString("0.00") : "0.00")" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label fw-bold">Total</label>
                        <div class="col-sm-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text ar-cur-symbol fw-bold">@(Model != null && !string.IsNullOrEmpty(Model.DocCur) ? Model.DocCur : "DKK")</span>
                                <input type="number" step="0.01" id="ar_DocTotal" class="form-control text-end fw-bold text-success" value="@(Model != null ? Model.DocTotal.ToString("0.00") : "0.00")" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="mb-2 row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label">Applied Amount</label>
                        <div class="col-sm-7">
                            <input type="number" step="0.01" id="ar_AppliedAmount" class="form-control form-control-sm text-end" value="0.00" readonly />
                        </div>
                    </div>

                    <div class="row align-items-center">
                        <label class="col-sm-5 col-form-label sneat-form-label fw-bold">Balance Due</label>
                        <div class="col-sm-7">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text ar-cur-symbol fw-bold">@(Model != null && !string.IsNullOrEmpty(Model.DocCur) ? Model.DocCur : "DKK")</span>
                                <input type="number" step="0.01" id="ar_BalanceDue" class="form-control text-end fw-bold text-danger" value="@(Model != null ? Model.DocTotal.ToString("0.00") : "0.00")" readonly />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (!isView)
            {
                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a href="@Url.Action("Index", "Invoice")" class="btn btn-outline-secondary">
                        <i class="bx bx-x me-1"></i> Cancel
                    </a>
                    <button type="button" class="btn btn-primary px-4" onclick="saveArForm()">
                        <i class="bx bx-save me-1"></i> @(isEdit ? "Save Changes" : "Save Invoice")
                    </button>
                </div>
            }
        </form>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('#ar_DocCur').on('change', function () {
            $('.ar-cur-symbol').text($(this).val());
        });

        // Initialize rows if empty and not in view mode
        if ($('#arGridBody tr').length === 0 && '@isView' !== 'True') {
            addArLineRow();
        }
    });

    function addArLineRow(lineData) {
        var isView = '@isView' === 'True';
        var rowIdx = $('#arGridBody tr').length + 1;

        var taxAmt = lineData ? parseFloat(lineData.VatAmount || 0).toFixed(2) : '0.00';
        var priceAfter = lineData ? parseFloat(lineData.UnitPrice || 0).toFixed(2) : '0.00';
        var discPct = lineData ? parseFloat(lineData.DiscountPercent || 0).toFixed(2) : '0.00';
        var itemCode = lineData ? (lineData.ItemCode || '') : '';
        var desc = lineData ? (lineData.Description || '') : '';
        var qty = lineData ? parseFloat(lineData.Quantity || 1).toFixed(2) : '1.00';
        var unitPrice = lineData ? parseFloat(lineData.UnitPrice || 0).toFixed(2) : '0.00';
        var taxCode = lineData ? (lineData.VatGroup || 'O1') : 'O1';
        var lineTotal = lineData ? parseFloat(lineData.LineTotal || 0).toFixed(2) : '0.00';
        var uom = lineData ? (lineData.UnitOfMeasure || 'Manual') : 'Manual';

        var tr = `
            <tr>
                <td class="ar-line-no text-center fw-bold text-muted">${rowIdx}</td>
                <td>
                    <input type="text" class="form-control form-control-sm ar-item-code" value="${itemCode}" placeholder="Item Code" ${isView ? 'readonly' : ''} />
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm ar-item-desc" value="${desc}" placeholder="Item Description" ${isView ? 'readonly' : ''} />
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-qty text-end" value="${qty}" onchange="recalcArRow(this)" ${isView ? 'readonly' : ''} />
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-unit-price text-end" value="${unitPrice}" onchange="recalcArRow(this)" ${isView ? 'readonly' : ''} />
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-disc-pct text-end" value="${discPct}" onchange="recalcArRow(this)" ${isView ? 'readonly' : ''} />
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-price-after text-end bg-light" value="${priceAfter}" readonly />
                </td>
                <td>
                    <select class="form-select form-select-sm ar-tax-code" onchange="recalcArRow(this)" ${isView ? 'disabled' : ''}>
                        <option value="O1" ${taxCode === 'O1' ? 'selected' : ''}>O1 (5%)</option>
                        <option value="S1" ${taxCode === 'S1' ? 'selected' : ''}>S1 (7%)</option>
                        <option value="EX" ${taxCode === 'EX' ? 'selected' : ''}>EX (0%)</option>
                    </select>
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-tax-amt text-end bg-light text-warning fw-semibold" value="${taxAmt}" readonly />
                </td>
                <td>
                    <input type="number" step="0.01" class="form-control form-control-sm ar-line-total text-end bg-light fw-bold text-success" value="${lineTotal}" readonly />
                </td>
                <td>
                    <select class="form-select form-select-sm ar-uom" ${isView ? 'disabled' : ''}>
                        <option value="Manual" ${uom === 'Manual' ? 'selected' : ''}>Manual</option>
                        <option value="6Pack" ${uom === '6Pack' ? 'selected' : ''}>6Pack</option>
                        <option value="Pack" ${uom === 'Pack' ? 'selected' : ''}>Pack</option>
                        <option value="Pcs" ${uom === 'Pcs' ? 'selected' : ''}>Pcs</option>
                    </select>
                </td>
                ${!isView ? `<td class="text-center"><button type="button" class="btn btn-sm btn-icon btn-outline-danger" onclick="removeArLineRow(this)" title="Delete Row"><i class="bx bx-trash"></i></button></td>` : ''}
            </tr>
        `;

        $('#arGridBody').append(tr);
        recalcArTotals();
    }

    function removeArLineRow(btn) {
        if ($('#arGridBody tr').length <= 1) {
            Swal.fire('Notice', 'At least one line item is required.', 'info');
            return;
        }
        $(btn).closest('tr').remove();
        $('#arGridBody tr').each(function (idx) {
            $(this).find('.ar-line-no').text(idx + 1);
        });
        recalcArTotals();
    }

    function recalcArRow(elem) {
        var row = $(elem).closest('tr');
        var qty = parseFloat(row.find('.ar-qty').val()) || 0;
        var unitPrice = parseFloat(row.find('.ar-unit-price').val()) || 0;
        var discPct = parseFloat(row.find('.ar-disc-pct').val()) || 0;

        var priceAfterDisc = unitPrice * (1.0 - (discPct / 100.0));
        var lineTotal = qty * priceAfterDisc;

        var taxCode = row.find('.ar-tax-code').val();
        var taxRate = 0.05;
        if (taxCode === 'S1') taxRate = 0.07;
        else if (taxCode === 'EX') taxRate = 0.00;

        var taxAmt = lineTotal * taxRate;

        row.find('.ar-price-after').val(priceAfterDisc.toFixed(2));
        row.find('.ar-line-total').val(lineTotal.toFixed(2));
        row.find('.ar-tax-amt').val(taxAmt.toFixed(2));

        recalcArTotals();
    }

    function recalcArTotals() {
        var subtotal = 0;
        var totalTax = 0;

        $('#arGridBody tr').each(function () {
            subtotal += parseFloat($(this).find('.ar-line-total').val()) || 0;
            totalTax += parseFloat($(this).find('.ar-tax-amt').val()) || 0;
        });

        $('#ar_TotalBeforeDiscount').val(subtotal.toFixed(2));

        var discPct = parseFloat($('#ar_DiscountPercent').val()) || 0;
        var discAmt = subtotal * (discPct / 100.0);
        $('#ar_DiscountTotal').val(discAmt.toFixed(2));

        var freight = parseFloat($('#ar_Freight').val()) || 0;
        var roundDiff = $('#ar_RoundingCheck').is(':checked') ? (parseFloat($('#ar_RoundDifference').val()) || 0) : 0;

        $('#ar_VatSum').val(totalTax.toFixed(2));

        var grandTotal = (subtotal - discAmt) + totalTax + freight + roundDiff;
        $('#ar_DocTotal').val(grandTotal.toFixed(2));
        $('#ar_BalanceDue').val(grandTotal.toFixed(2));
    }

    function saveArForm() {
        var docEntry = parseInt($('#ar_DocEntry').val()) || 0;
        var cardCode = $('#ar_CardCode').val().trim();
        var cardName = $('#ar_CardName').val().trim();

        if (!cardCode && !cardName) {
            Swal.fire('Validation Warning', 'Please enter Customer Code or Customer Name.', 'warning');
            return;
        }

        var lines = [];
        $('#arGridBody tr').each(function (idx) {
            var itemCode = $(this).find('.ar-item-code').val().trim();
            var desc = $(this).find('.ar-item-desc').val().trim();
            var qty = parseFloat($(this).find('.ar-qty').val()) || 0;
            var unitPrice = parseFloat($(this).find('.ar-unit-price').val()) || 0;
            var discPct = parseFloat($(this).find('.ar-disc-pct').val()) || 0;
            var taxCode = $(this).find('.ar-tax-code').val();
            var lineTotal = parseFloat($(this).find('.ar-line-total').val()) || 0;
            var vatAmt = parseFloat($(this).find('.ar-tax-amt').val()) || 0;
            var uom = $(this).find('.ar-uom').val();

            lines.push({
                LineNum: idx + 1,
                ItemCode: itemCode,
                Description: desc,
                Quantity: qty,
                UnitPrice: unitPrice,
                DiscountPercent: discPct,
                VatGroup: taxCode,
                LineTotal: lineTotal,
                VatAmount: vatAmt,
                UnitOfMeasure: uom
            });
        });

        var headerData = {
            DocEntry: docEntry,
            DocNum: parseInt($('#ar_DocNum').val()) || 0,
            DocCur: $('#ar_DocCur').val(),
            DocDate: $('#ar_DocDate').val(),
            DocDueDate: $('#ar_DocDueDate').val() || null,
            CardCode: cardCode,
            CardName: cardName,
            BuyerReference: $('#ar_BuyerReference').val(),
            CustomerContactName: $('#ar_ContactPerson').val(),
            ExchangeRate: parseFloat($('#ar_ExchangeRate').val()) || 1.0,
            VatSum: parseFloat($('#ar_VatSum').val()) || 0,
            DiscountTotal: parseFloat($('#ar_DiscountTotal').val()) || 0,
            RoundDifference: $('#ar_RoundingCheck').is(':checked') ? (parseFloat($('#ar_RoundDifference').val()) || 0) : 0,
            DocTotal: parseFloat($('#ar_DocTotal').val()) || 0,
            PaymentTerms: $('#ar_PaymentTerms').val(),
            BankCode: $('#ar_BankCode').val(),
            IBAN: $('#ar_IBAN').val(),
            CustomerStreet: $('#ar_CustomerStreet').val(),
            CustomerCity: $('#ar_CustomerCity').val(),
            CustomerZip: $('#ar_CustomerZip').val(),
            CustomerCountry: $('#ar_CustomerCountry').val(),
            BillingAddressCode: $('#ar_BillingAddressCode').val(),
            SupplierName: $('#ar_SupplierName').val(),
            SupplierVAT: $('#ar_SupplierVAT').val()
        };

        var titleMsg = docEntry > 0 ? 'Saving Invoice...' : 'Creating Invoice...';
        var textMsg = docEntry > 0 ? 'Please wait while the invoice is being updated.' : 'Please wait while the new invoice record is being created.';

        Swal.fire({
            title: titleMsg,
            text: textMsg,
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        $.ajax({
            url: '@Url.Action("SaveInvoice", "Invoice")',
            type: 'POST',
            data: JSON.stringify({ header: headerData, lines: lines }),
            contentType: 'application/json; charset=utf-8',
            success: function (res) {
                if (res.success) {
                    Swal.fire('Success!', res.message, 'success').then(() => {
                        window.location.href = '@Url.Action("Index", "Invoice")';
                    });
                } else {
                    Swal.fire('Error', res.message, 'error');
                }
            },
            error: function () {
                Swal.fire('Error', 'An error occurred while saving the invoice.', 'error');
            }
        });
    }
</script>

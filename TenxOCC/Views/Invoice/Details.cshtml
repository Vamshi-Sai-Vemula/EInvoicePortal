@model TenxOCC.Data.Entities.InvoiceHeader

@{
    ViewBag.Title = "A/R Invoice Details #" + (Model != null ? Model.DocEntry.ToString() : "");
    ViewBag.FormMode = "view";
}

<div class="container-xxl flex-grow-1 container-p-y">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold py-1 mb-0">
                <span class="text-muted fw-light">Invoices /</span> View A/R Invoice #@(Model != null ? Model.DocEntry : 0)
            </h4>
        </div>
        <div>
            <a href="@Url.Action("Edit", "Invoice", new { id = Model != null ? Model.DocEntry : 0 })" class="btn btn-warning me-2">
                <i class="bx bx-edit me-1"></i> Edit Invoice
            </a>
            <a href="@Url.Action("Index", "Invoice")" class="btn btn-outline-secondary">
                <i class="bx bx-arrow-back me-1"></i> Back to Invoices
            </a>
        </div>
    </div>

    @Html.Partial("_ARInvoiceForm", Model)
</div>

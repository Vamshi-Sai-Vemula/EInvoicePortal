@model IEnumerable<TenxOCC.Data.Entities.InvoiceHeader>

@{
    ViewBag.Title = "A/R Invoice Management";
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;
}

@functions {
    public static string FormatCompactNumber(decimal value)
    {
        decimal absVal = Math.Abs(value);
        if (absVal >= 1000000000m)
        {
            return (value / 1000000000m).ToString("0.##") + "B";
        }
        if (absVal >= 1000000m)
        {
            return (value / 1000000m).ToString("0.##") + "M";
        }
        if (absVal >= 1000m)
        {
            return (value / 1000m).ToString("0.##") + "K";
        }
        return value.ToString("N2");
    }

    public static string FormatCompactNumber(long value)
    {
        long absVal = Math.Abs(value);
        if (absVal >= 1000000000)
        {
            return ((double)value / 1000000000).ToString("0.##") + "B";
        }
        if (absVal >= 1000000)
        {
            return ((double)value / 1000000).ToString("0.##") + "M";
        }
        if (absVal >= 1000)
        {
            return ((double)value / 1000).ToString("0.##") + "K";
        }
        return value.ToString();
    }
}

<style>
    #invoiceTable th,
    #invoiceTable td {
        white-space: nowrap;
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Page Header & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold py-1 mb-0 text-primary">
                <i class="bx bx-receipt me-2"></i>A/R Invoice Management
            </h4>
            <p class="text-muted mb-0 small">Create, edit, view, and manage A/R Invoices with full line item breakdown.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-success shadow-sm" id="btnBulkApprove" onclick="bulkApproveInvoices()" disabled>
                <i class="bx bx-check-double me-1"></i> Bulk Approve (<span id="selectedCount">0</span>)
            </button>
            @*<a href="@Url.Action("Create", "Invoice")" class="btn btn-primary shadow-sm">
                <i class="bx bx-plus me-1"></i> Create New Invoice
            </a>*@
            <button class="btn btn-outline-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#uploadExcelModal">
                <i class="bx bx-upload me-1"></i> Upload Excel Invoice
            </button>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-primary border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-primary p-2 rounded">
                            <i class="bx bx-receipt fs-3 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Total Invoices</h6>
                            <h4 class="fw-bold mb-0">@FormatCompactNumber(Model != null ? Model.Count() : 0)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-success border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-success p-2 rounded">
                            <i class="bx bx-dollar-circle fs-3 text-success"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Total Revenue</h6>
                            <h4 class="fw-bold mb-0" title="Full Total: @(Model != null ? Model.Sum(x => x.DocTotal).ToString("N2") : "0.00")">@FormatCompactNumber(Model != null ? Model.Sum(x => x.DocTotal) : 0m)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-warning border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-warning p-2 rounded">
                            <i class="bx bx-calculator fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Total VAT Sum</h6>
                            <h4 class="fw-bold mb-0" title="Full VAT: @(Model != null ? Model.Sum(x => x.VatSum).ToString("N2") : "0.00")">@FormatCompactNumber(Model != null ? Model.Sum(x => x.VatSum) : 0m)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 border-start border-info border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-info p-2 rounded">
                            <i class="bx bx-list-ol fs-3 text-info"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Total Line Items</h6>
                            <h4 class="fw-bold mb-0">@FormatCompactNumber(Model != null ? Model.Sum(x => x.InvoiceLines != null ? (long)x.InvoiceLines.Count : 0L) : 0L)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Invoices Table Card -->
    <div class="card shadow-sm">
        @*<div class="card-header d-flex justify-content-between align-items-center py-3 border-bottom">
            <h5 class="card-title mb-0 fw-bold"><i class="bx bx-table me-2 text-primary"></i>A/R Invoice Records</h5>
            <a href="@Url.Action("Create", "Invoice")" class="btn btn-sm btn-primary">
                <i class="bx bx-plus me-1"></i> Add Invoice
            </a>
        </div>*@
        <div class="card-body pt-3">
            <div class="table-responsive">
                <table id="invoiceTable" class="table table-hover align-middle border">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 38px;" class="text-center">
                                <input type="checkbox" id="selectAllInvoices" class="form-check-input" title="Select All Invoices" />
                            </th>
                            <th>DocEntry</th>
                            <th>DocNum</th>
                            <th>Card Code</th>
                            <th>Card Name</th>
                            <th>Doc Date</th>
                            <th>Due Date</th>
                            <th>Doc Total</th>
                            <th>VAT Sum</th>
                            <th>Lines</th>
                            <th>Status</th>
                            <th>Approved</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                bool isApproved = string.Equals(item.Approved, "Yes", StringComparison.OrdinalIgnoreCase);
                                bool isFailed = string.Equals(item.Status, "Failed", StringComparison.OrdinalIgnoreCase);
                                string statusText = !string.IsNullOrEmpty(item.Status) ? item.Status : "Success";
                                string approvedText = isApproved ? "Yes" : "No";
                                int linesCount = item.InvoiceLines != null ? item.InvoiceLines.Count : 0;

                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox" class="form-check-input invoice-chk" value="@item.DocEntry" />
                                    </td>
                                    <td><span class="badge bg-label-primary fw-bold">#@item.DocEntry</span></td>
                                    <td>@item.DocNum</td>
                                    <td><strong>@(string.IsNullOrEmpty(item.CardCode) ? "N/A" : item.CardCode)</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.CardName) ? item.CustomerVAT ?? item.SupplierName ?? "N/A" : item.CardName)</td>
                                    <td>@item.DocDate.ToString("yyyy-MM-dd")</td>
                                    <td>@(item.DocDueDate.HasValue ? item.DocDueDate.Value.ToString("yyyy-MM-dd") : "-")</td>
                                    <td class="fw-bold text-success" data-order="@item.DocTotal" title="Full Total: @item.DocTotal.ToString("N2") @(string.IsNullOrEmpty(item.DocCur) ? "DKK" : item.DocCur)">@FormatCompactNumber(item.DocTotal) @(string.IsNullOrEmpty(item.DocCur) ? "DKK" : item.DocCur)</td>
                                    <td class="text-warning fw-semibold" data-order="@item.VatSum" title="Full VAT: @item.VatSum.ToString("N2")">@FormatCompactNumber(item.VatSum)</td>
                                    <td data-order="@linesCount"><span class="badge bg-label-info">@FormatCompactNumber((long)linesCount) Lines</span></td>
                                    <td>
                                        <span class="badge @(isFailed ? "bg-danger" : "bg-success")" title="@(!string.IsNullOrEmpty(item.ErrorMessage) ? item.ErrorMessage : "")">
                                            @statusText
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @(isApproved ? "bg-success" : "bg-secondary")">
                                            @approvedText
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", "Invoice", new { id = item.DocEntry })" class="btn btn-sm btn-icon btn-outline-info" title="View Invoice">
                                                <i class="bx bx-show"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Invoice", new { id = item.DocEntry })" class="btn btn-sm btn-icon btn-outline-warning" title="Edit Invoice">
                                                <i class="bx bx-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-icon btn-outline-danger" title="Delete Invoice" onclick="confirmDeleteInvoice(@item.DocEntry)">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- EXCEL UPLOAD MODAL                         -->
<!-- ========================================== -->
<div class="modal fade" id="uploadExcelModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            @using (Html.BeginForm("Create", "Invoice", FormMethod.Post, new { enctype = "multipart/form-data", id = "uploadExcelForm" }))
            {
                @Html.AntiForgeryToken()
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title text-white"><i class="bx bx-file-find me-2"></i>Upload SAP Invoice Excel</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-info border-0 shadow-sm mb-3">
                        <div class="d-flex align-items-center">
                            <i class="bx bx-info-circle fs-4 me-2"></i>
                            <div>
                                <strong>Excel Format Requirements:</strong>
                                <ul class="mb-0 ps-3 small">
                                    <li>Workbook must contain <strong>Header</strong> and <strong>Line</strong> sheets.</li>
                                    <li>Use <strong>ExcelDocEntry</strong> (or <strong>DocEntry</strong>) to link Header and Line rows.</li>
                                    <li>SQL Server generates new database <strong>DocEntry</strong> values automatically.</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Select Excel File (.xlsx or .xls)</label>
                        <input type="file" name="ExcelFile" class="form-control" accept=".xlsx, .xls" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="bx bx-cloud-upload me-1"></i> Upload & Import</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Initialize DataTables
            $('#invoiceTable').DataTable({
                responsive: true,
                autoWidth: true,
                order: [[1, 'desc']],
                pageLength: 10,
                columnDefs: [
                    { targets: 0, orderable: false }
                ]
            });

            // Select All Checkbox Handler
            $('#selectAllInvoices').on('change', function () {
                var checked = $(this).is(':checked');
                $('.invoice-chk').prop('checked', checked);
                updateBulkApproveState();
            });

            // Individual Row Checkbox Handler
            $(document).on('change', '.invoice-chk', function () {
                updateBulkApproveState();
            });

            @if (!string.IsNullOrEmpty(successMsg))
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    html: '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg))',
                    confirmButtonColor: '#3085d6'
                });
                </text>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    html: '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg))',
                    confirmButtonColor: '#d33'
                });
                </text>
            }
        });

        function updateBulkApproveState() {
            var selectedIds = getSelectedInvoiceIds();
            var count = selectedIds.length;
            $('#selectedCount').text(count);
            if (count > 0) {
                $('#btnBulkApprove').prop('disabled', false);
            } else {
                $('#btnBulkApprove').prop('disabled', true);
            }
        }

        function getSelectedInvoiceIds() {
            var ids = [];
            $('.invoice-chk:checked').each(function () {
                var val = parseInt($(this).val());
                if (val > 0) {
                    ids.push(val);
                }
            });
            return ids;
        }

        function bulkApproveInvoices() {
            var ids = getSelectedInvoiceIds();
            if (ids.length === 0) {
                Swal.fire('Notice', 'Please select at least one invoice document to approve.', 'info');
                return;
            }

            Swal.fire({
                title: 'Bulk Approve Invoices?',
                text: 'Are you sure you want to approve and post ' + ids.length + ' selected invoice document(s) to the External API?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bx bx-check-double me-1"></i> Yes, Approve & Post All!'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Processing Bulk Approval...',
                        text: 'Approving invoices and posting to External E-Invoicing Gateway...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("BulkApproveInvoices", "Invoice")',
                        type: 'POST',
                        data: JSON.stringify({ ids: ids }),
                        contentType: 'application/json; charset=utf-8',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Bulk Approval Successful!', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Bulk Approval Failed', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred during bulk invoice approval.', 'error');
                        }
                    });
                }
            });
        }

        function confirmDeleteInvoice(docEntry) {
            Swal.fire({
                title: 'Are you sure?',
                text: "Deleting Invoice #" + docEntry + " will permanently remove its header and all line items!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Deleting...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("DeleteInvoice", "Invoice")',
                        type: 'POST',
                        data: { id: docEntry },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Delete Failed', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred while deleting the invoice.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}
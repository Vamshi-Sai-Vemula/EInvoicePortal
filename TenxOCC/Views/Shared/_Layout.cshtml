
<!DOCTYPE html>

<html lang="en"
      class="light-style layout-navbar-fixed layout-menu-fixed"
      dir="ltr"
      data-theme="theme-default"
      data-assets-path="@Styles.Url("~/Content/")"
      data-template="vertical-menu-template-no-customizer-starter">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />

    <title>10XOCC</title>

    <meta name="description" content="" />



    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/Content/img/Fitone.png")" />

    <!-- Icons -->
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/fonts/boxicons.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/fonts/fontawesome.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/fonts/flag-icons.css")" />

    <!-- Core CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/bootstrap/bootstrap.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/css/core.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/css/theme-raspberry-dark.css")" class="template-customizer-theme-css" />
    <link rel="stylesheet" href="@Url.Content("~/Content/css/demo.css")" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/perfect-scrollbar/perfect-scrollbar.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/typeahead-js/typeahead.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/bs-stepper/bs-stepper.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/apex-charts/apex-charts.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/jquery-ui/jquery-ui.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/select2/select2.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/tagify/tagify.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/flatpickr/flatpickr.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/formvalidation/dist/css/formValidation.min.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/sweetalert2/sweetalert2.min.css")" />

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/datatables/dataTables.dataTables.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/datatables-columncontrol/columnControl.dataTables.css")" />
    <link rel="stylesheet" href="@Url.Content("~/Content/vendor/libs/datatables-buttons/buttons.dataTables.css")" />

    <!-- Helpers & Config JS -->
    <script src="@Url.Content("~/Content/vendor/js/helpers.js")"></script>
    <script src="@Url.Content("~/Content/js/config.js")"></script>

    <style>
        /* Prevent horizontal scroll globally */
        html, body {
            max-width: 100%;
            overflow-x: hidden;
        }

        /* Allow navbar dropdowns to render properly */
        .layout-navbar {
            overflow-x: visible !important;
        }

        /* Prevent dropdown from forcing page width */
        .dropdown-menu {
            max-width: 260px;
            overflow-x: hidden;
        }


        /* override bootstrap table input behaviour */
        #dataTable input.form-control,
        #dataTable select.form-select {
            width: auto !important;
        }

        .col-form-label {
            text-transform: none !important;
        }

        .table th {
            text-transform: none !important;
        }

        #asideBrand {
            display: none;
        }
        /* Light & thin scrollbar for DataTable only */
        .dataTables_scrollBody::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        .dataTables_scrollBody::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .dataTables_scrollBody::-webkit-scrollbar-thumb {
            background: #cfcfcf;
            border-radius: 10px;
        }

            .dataTables_scrollBody::-webkit-scrollbar-thumb:hover {
                background: #b5b5b5;
            }
    </style>

</head>

<body>

    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <!-- Menu -->


            <aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
                <div class="app-brand demo" style="padding-left:1rem">
                    <a href="@Url.Action("Index", "Home")" class="app-brand-link">
                        <span class="app-brand-logo demo">
                            <span id="brandicon" class="text-primary">
                                <img src="@Styles.Url("~/Content/img/10x.png")" style="height:40px;width:50px;" />
                            </span>
                        </span>
                        <span id="brandlogo" class="app-brand-text demo menu-text fw-bold ms-2">
                            <img src="@Styles.Url("~/Content/img/einvoice.png")" style="height:40px;width:100px; padding-left:10px" />
                        </span>
                    </a>

                    <a href="" class="layout-menu-toggle menu-link text-large ms-auto">
                        <i class="bx bx-chevron-left bx-sm align-middle"></i>
                    </a>
                </div>

                <div class="menu-inner-shadow"></div>
          
                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                }

                <ul class="menu-inner py-1">

                    <li class="menu-item @(currentController == "Home" && currentAction == "Index" ? "active" : "")">
                        <a href="@Url.Action("Index", "Home")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>

                    <li class="menu-item @(currentController == "Configuration" && currentAction == "load" ? "active" : "")">
                        <a href="@Url.Action("load", "Configuration")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-group"></i>
                            <div>Configuration</div>
                        </a>
                    </li>

                    <li class="menu-item @(currentController == "CompanyDetails" && currentAction == "CompanyDetails" ? "active" : "")">
                        <a href="@Url.Action("CompanyDetails", "CompanyDetails")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-group"></i>
                            <div>CompanyDetails</div>
                        </a>
                    </li>

                    <li class="menu-item @(currentController == "Invoice" && currentAction == "Index" ? "active" : "")">
                        <a href="@Url.Action("Index", "Invoice")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-receipt"></i>
                            <div>Invoices</div>
                        </a>
                    </li>

                </ul>
                

                @*<ul class="menu-inner py-1">

                    <li class="menu-item active">
                        <a href="@Url.Action("Index", "Home")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-home"></i>
                            <div>Dashboard</div>
                        </a>
                    </li>


                    <li class="menu-item">
                        <a href="@Url.Action("load", "Configuration")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-group"></i>
                            <div>Configuration</div>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="@Url.Action("CompanyDetails", "CompanyDetails")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-group"></i>
                            <div>CompanyDetails</div>
                        </a>
                    </li>
                    <li class="menu-item">
                        <a href="@Url.Action("Index", "Invoice")" class="menu-link">
                            <i class="menu-icon tf-icons bx bx-receipt"></i>
                            <div>Invoices</div>
                        </a>
                    </li>

                </ul>*@



            </aside>
            <!-- / Menu -->
            <!-- Layout container -->
            <div class="layout-page ">
                <!-- Navbar -->

                <nav class="layout-navbar container-xxl navbar navbar-expand-xl navbar-detached align-items-center bg-navbar-theme"
                     id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav d-xl-none align-items-xl-center me-3 me-xl-0">
                        <a class="nav-item nav-link px-0 me-xl-4" href="javascript:void(0)">
                            <i class="bx bx-menu bx-sm"></i>
                        </a>
                    </div>

                    @*<img src="~/Content/img/Thai.jpeg"
                         alt="Logo"
                         style="width:70px;height:50px;object-fit:cover;" />*@


                    <div class="d-flex flex-column col-4 m-3">
                        <span class="fw-bold fs-5 text-white">10X E-Invoicing</span>
                        <small class="text-muted fw-semibold">E Invoicing Test</small>
                    </div>


                    <div class="navbar-nav-right d-flex align-items-center" id="navbar-collapse">
                        <!-- Search -->
                        <!--<div class="navbar-nav align-items-center">
                        <div class="nav-item navbar-search-wrapper mb-0">-->
                        @*<a class="nav-item nav-link search-toggler px-0" href="javascript:void(0);">
                                <i class="bx bx-search bx-sm"></i>
                                <span class="d-none d-md-inline-block text-muted">Search (Ctrl+/)</span>
                            </a>*@
                        <!--</div>
                        </div>-->
                        <!-- /Search -->

                        <ul class="navbar-nav flex-row align-items-center ms-auto">
                            <!-- User -->
                            <li class="nav-item navbar-dropdown dropdown-user dropdown">
                                <a class="nav-link dropdown-toggle hide-arrow" href="javascript:void(0);" data-bs-toggle="dropdown">
                                    @*<div class="avatar avatar-online">
                                            <img src="@Styles.Url("~/Content/img/avatars/1.png")" alt="brand icon" class="w-px-40 h-auto rounded-circle" />
                                        </div>*@
                                    <div class="avatar avatar-online d-flex align-items-center justify-content-center "
                                         style="width:40px;height:40px;">
                                        <i class="bx bx-user fs-4"></i>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item" href="">
                                            <div class="d-flex">
                                                <div class="flex-shrink-0 me-3">
                                                    @*<div class="avatar avatar-online">
                                                            <img src="@Styles.Url("~/Content/img/avatars/1.png")" alt="brand" class="w-px-40 h-auto rounded-circle" />
                                                        </div>*@
                                                    <div class="avatar avatar-online d-flex align-items-center justify-content-center "
                                                         style="width:40px;height:40px;">
                                                        <i class="bx bx-user fs-4"></i>
                                                    </div>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <span class="d-block fw-semibold">@User.Identity.Name</span>
                                                    @*<small class="text-muted">Admin</small>*@
                                                </div>
                                            </div>
                                        </a>
                                    </li>
                                    <li>
                                        <div class="dropdown-divider"></div>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Index", "UserProfile")">
                                            <i class="bx bx-user me-2"></i>
                                            <span class="align-middle">My Profile</span>
                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" href="@Url.Action("Logout", "Account")" target="">
                                            <i class="bx bx-power-off me-2"></i>
                                            <span class="align-middle">Log Out</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <!--/ User -->
                        </ul>
                    </div>

                    <!-- Search Small Screens -->
                    <div class="navbar-search-wrapper search-input-wrapper d-none">
                        <input type="text"
                               class="form-control search-input container-xxl border-0"
                               placeholder="Search..."
                               aria-label="Search..." />
                        <i class="bx bx-x bx-sm search-toggler cursor-pointer"></i>
                    </div>
                </nav>

                <!-- / Navbar -->
                <!-- Content wrapper -->
                <div class="content-wrapper">
                    <!-- Content -->

                    <div class="container-xxl flex-grow-1 container-p-y">
                        @RenderBody()
                    </div>
                    <!-- / Content -->
                    <!-- Footer -->
                    <footer class="content-footer footer bg-footer-theme">
                        <div class="container-xxl d-flex flex-column flex-md-row flex-wrap justify-content-between py-2">
                            <div class="mb-2 mb-md-0">
                                ©
                                <script>
                                    document.write(new Date().getFullYear());
                                </script>
                                , made by <a href="https://10xsf.com/" style="text-decoration:none; color:white;">10<span style="color:red;">X</span> Software Foundations</a>
                            </div>
                            <div>
                                <a href="https://10xsf.com/" class="footer-link me-4">Website</a>
                                <a href="" class="footer-link me-4">License</a>

                                <a href=""
                                   class="footer-link d-none d-sm-inline-block">Support</a>
                            </div>
                        </div>
                    </footer>
                    <!-- / Footer -->

                    <div class="content-backdrop fade"></div>
                </div>
                <!-- Content wrapper -->
            </div>
            <!-- / Layout page -->
        </div>

        <!-- Overlay -->
        <div class="layout-overlay layout-menu-toggle"></div>

        <!-- Drag Target Area To SlideIn Menu On Small Screens -->
        <div class="drag-target"></div>
    </div>
    <!-- / Layout wrapper -->
    <!-- Core JS -->
    <script src="@Url.Content("~/Scripts/jquery-3.7.1.min.js")"></script>
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/popper/popper.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/perfect-scrollbar/perfect-scrollbar.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/hammer/hammer.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/i18n/i18n.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/typeahead-js/typeahead.js")"></script>
    <script src="@Url.Content("~/Content/vendor/js/menu.js")"></script>

    <!-- UI & Vendor JS -->
    <script src="@Url.Content("~/Content/vendor/libs/jquery-ui/jquery-ui.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/moment/moment.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/sweetalert2/sweetalert2.all.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/apex-charts/apexcharts.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/bs-stepper/bs-stepper.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/cleavejs/cleave.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/cleavejs/cleave-phone.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/select2/select2.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/tagify/tagify.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/flatpickr/flatpickr.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/formvalidation/dist/js/FormValidation.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/formvalidation/dist/js/plugins/Bootstrap5.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/formvalidation/dist/js/plugins/AutoFocus.min.js")"></script>

    <!-- DataTables & Extensions JS -->
    <script src="@Url.Content("~/Content/vendor/libs/datatables/dataTables.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/datatables-columncontrol/dataTables.columnControl.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/colresizable/colResizable-1.6.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/jszip/jszip.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/pdfmake/pdfmake.min.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/pdfmake/vfs_fonts.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/datatables-buttons/dataTables.buttons.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/datatables-buttons/buttons.html5.js")"></script>
    <script src="@Url.Content("~/Content/vendor/libs/datatables-buttons/buttons.print.js")"></script>

    <!-- Main & App JS -->
    <script src="@Url.Content("~/Content/js/wizard-ex-property-listing1.js")"></script>
    <script src="@Url.Content("~/Content/js/main.js")"></script>
    <script src="@Url.Content("~/Content/js/dashboards-analytics.js")"></script>

    @RenderSection("scripts", required: false)




</body>
</html>

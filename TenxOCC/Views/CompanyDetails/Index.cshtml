@model IEnumerable<TenxOCC.Data.Entities.CompanyDetailsEntity>

@{
    ViewBag.Title = "Company Details Directory";
    var successMsg = TempData["SuccessMessage"] as string;
    var errorMsg = TempData["ErrorMessage"] as string;
}

<style>
    #companyTable th,
    #companyTable td {
        white-space: nowrap;
    }
</style>

<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Page Header & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="fw-bold py-1 mb-0 text-primary">
                <i class="bx bx-building-house me-2"></i>Company Details Directory
            </h4>
            <p class="text-muted mb-0 small">Create, edit, view, and manage multiple company details profiles, currencies, and tax references.</p>
        </div>
        <div>
            <a href="@Url.Action("CompanyDetails", "CompanyDetails")" class="btn btn-primary shadow-sm">
                <i class="bx bx-plus me-1"></i> Add New Company Details
            </a>
        </div>
    </div>

    <!-- Summary Metrics Cards -->
    <div class="row mb-4">
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-primary border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-primary p-2 rounded">
                            <i class="bx bx-building fs-3 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Total Companies</h6>
                            <h4 class="fw-bold mb-0">@(Model != null ? Model.Count() : 0)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-success border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-success p-2 rounded">
                            <i class="bx bx-globe fs-3 text-success"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Local Profiles</h6>
                            <h4 class="fw-bold mb-0">@(Model != null ? Model.Count(x => !string.IsNullOrEmpty(x.companyNameLocal)) : 0)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3 mb-3 mb-lg-0">
            <div class="card h-100 border-start border-warning border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-warning p-2 rounded">
                            <i class="bx bx-map-pin fs-3 text-warning"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Foreign Profiles</h6>
                            <h4 class="fw-bold mb-0">@(Model != null ? Model.Count(x => !string.IsNullOrEmpty(x.companyNameForeign)) : 0)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card h-100 border-start border-info border-4 shadow-sm">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center">
                        <div class="avatar me-3 bg-label-info p-2 rounded">
                            <i class="bx bx-receipt fs-3 text-info"></i>
                        </div>
                        <div>
                            <h6 class="mb-0 text-muted small">Tax Registered</h6>
                            <h4 class="fw-bold mb-0">@(Model != null ? Model.Count(x => !string.IsNullOrEmpty(x.federalTaxId1)) : 0)</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Companies Table Card -->
    <div class="card shadow-sm">
        <div class="card-body pt-3">
            <div class="table-responsive">
                <table id="companyTable" class="table table-hover align-middle border">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Company Name (Local)</th>
                            <th>Company Name (Foreign)</th>
                            <th>Federal Tax ID / VAT</th>
                            <th>Local Currency</th>
                            <th>City / Country</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="badge bg-label-primary fw-bold">#@item.Id</span></td>
                                    <td><strong>@(string.IsNullOrEmpty(item.companyNameLocal) ? "N/A" : item.companyNameLocal)</strong></td>
                                    <td>@(string.IsNullOrEmpty(item.companyNameForeign) ? "-" : item.companyNameForeign)</td>
                                    <td><span class="badge bg-label-info">@(string.IsNullOrEmpty(item.federalTaxId1) ? "N/A" : item.federalTaxId1)</span></td>
                                    <td><span class="fw-bold text-success">@(string.IsNullOrEmpty(item.localCurrency) ? "DKK" : item.localCurrency)</span></td>
                                    <td>@(string.IsNullOrEmpty(item.cityLocal) ? "-" : item.cityLocal) / @(string.IsNullOrEmpty(item.countryLocal) ? "-" : item.countryLocal)</td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("CompanyDetails", "CompanyDetails", new { id = item.Id })" class="btn btn-sm btn-icon btn-outline-warning" title="Edit Company Details">
                                                <i class="bx bx-edit"></i>
                                            </a>
                                            <button class="btn btn-sm btn-icon btn-outline-danger" title="Delete Company Details" onclick="confirmDeleteCompany(@item.Id, '@Html.Raw(HttpUtility.JavaScriptStringEncode(item.companyNameLocal ?? "Company #" + item.Id))')">
                                                <i class="bx bx-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $('#companyTable').DataTable({
                responsive: true,
                autoWidth: true,
                order: [[0, 'desc']],
                pageLength: 10
            });

            @if (!string.IsNullOrEmpty(successMsg))
            {
                <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    html: '@Html.Raw(HttpUtility.JavaScriptStringEncode(successMsg))',
                    confirmButtonColor: '#696cff'
                });
                </text>
            }

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    html: '@Html.Raw(HttpUtility.JavaScriptStringEncode(errorMsg))',
                    confirmButtonColor: '#d33'
                });
                </text>
            }
        });

        function confirmDeleteCompany(id, name) {
            Swal.fire({
                title: 'Delete Company Details?',
                text: "Are you sure you want to delete '" + name + "'? This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="bx bx-trash me-1"></i> Yes, Delete!'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        title: 'Deleting...',
                        allowOutsideClick: false,
                        didOpen: () => { Swal.showLoading(); }
                    });

                    $.ajax({
                        url: '@Url.Action("Delete", "CompanyDetails")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Deleted!', res.message, 'success').then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Delete Failed', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error', 'An error occurred while deleting the company details record.', 'error');
                        }
                    });
                }
            });
        }
    </script>
}

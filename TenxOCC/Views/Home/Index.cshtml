@model TenxOCC.Web.Models.DashboardViewModel

@{
    ViewBag.Title = "Dashboard - 10X E-Invoicing";
}

<style>
     .kpi-card {
         border-radius: 0.75rem;
         transition: transform 0.2s ease, box-shadow 0.2s ease;
     }

         .kpi-card:hover {
             transform: translateY(-3px);
             box-shadow: 0 0.5rem 1.25rem rgba(0, 0, 0, 0.08) !important;
         }

     .workflow-step-icon {
         width: 48px;
         height: 48px;
         border-radius: 50%;
         display: flex;
         align-items: center;
         justify-content: center;
         font-size: 1.5rem;
     }

     .uuid-badge {
         font-family: 'Courier New', Courier, monospace;
         letter-spacing: 0.5px;
         font-size: 0.75rem;
     }
     /* =========================================================
    AUTO-SIZE TABLE COLUMNS BASED ON HEADER + BODY CONTENT
    ========================================================= */

     .invoice-table-wrapper {
         width: 100%;
         overflow-x: auto;
         overflow-y: hidden;
         -webkit-overflow-scrolling: touch;
     }

     .invoice-table {
         table-layout: auto !important;
         width: max-content !important;
         min-width: 100%;
         margin-bottom: 0;
     }

         .invoice-table th,
         .invoice-table td {
             width: auto !important;
             min-width: 0 !important;
             max-width: none !important;
             /* Keep header and data in one line */
             white-space: nowrap !important;
             /* Prevent wrapping */
             word-break: normal !important;
             overflow-wrap: normal !important;
             vertical-align: middle;
         }

         /* Header text must remain single-line */
         .invoice-table thead th {
             white-space: nowrap !important;
         }

         /* UUID should also stay on one line */
         .invoice-table .uuid-badge {
             white-space: nowrap !important;
         }
</style>
@functions {
    public string FormatCompactNumber(decimal value)
    {
        decimal absValue = Math.Abs(value);

        if (absValue >= 1000000000)
            return (value / 1000000000M).ToString("0.##") + "B";

        if (absValue >= 1000000)
            return (value / 1000000M).ToString("0.##") + "M";

        if (absValue >= 1000)
            return (value / 1000M).ToString("0.##") + "K";

        return value.ToString("0.##");
    }
}

